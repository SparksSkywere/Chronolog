<Window x:Class="Chronolog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chronolog"
        Height="640"
        Width="960"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FaceBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource InkBrush}"
        Icon="pack://application:,,,/Assets/chronolog.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource RetroMenu}">
            <MenuItem Header="_File" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_New Entry" InputGestureText="Ctrl+N" Click="NewEntry_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" Style="{StaticResource SubMenuItem}"/>
                <Separator/>
                <MenuItem Header="New _Journal..." Click="NewJournal_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Rename Journal..." Click="RenameJournal_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Delete Journal..." Click="DeleteJournal_Click" Style="{StaticResource SubMenuItem}"/>
                <Separator/>
                <MenuItem Header="Open Data _Folder..." Click="OpenDataFolder_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Storage Location..." Click="StorageLocation_Click" Style="{StaticResource SubMenuItem}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" Style="{StaticResource SubMenuItem}"/>
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Edit Entry..." Click="EditEntry_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Delete Entry" InputGestureText="Del" Click="DeleteEntry_Click" Style="{StaticResource SubMenuItem}"/>
                <Separator/>
                <MenuItem Header="_Find" InputGestureText="Ctrl+F" Click="FocusSearch_Click" Style="{StaticResource SubMenuItem}"/>
            </MenuItem>
            <MenuItem Header="_Journal" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_Write Journal" Click="NewEntry_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Previous Entry" Click="PreviousEntry_Click" Style="{StaticResource SubMenuItem}"/>
                <MenuItem Header="_Next Entry" Click="NextEntry_Click" Style="{StaticResource SubMenuItem}"/>
            </MenuItem>
            <MenuItem x:Name="ThemeMenu" Header="_Theme" Style="{StaticResource TopLevelMenuItem}">
                <!-- Filled in code-behind -->
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource TopLevelMenuItem}">
                <MenuItem Header="_About Chronolog..." Click="About_Click" Style="{StaticResource SubMenuItem}"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource StatusBarBrush}"
                BorderBrush="{DynamicResource ShadowBrush}"
                BorderThickness="0,1,0,0"
                Padding="2">
            <Border Style="{DynamicResource StatusPanel}">
                <TextBlock x:Name="StatusText"
                           Style="{DynamicResource StatusBarText}"
                           Text="Ready"/>
            </Border>
        </Border>

        <!-- Main content -->
        <Border Margin="8"
                Style="{DynamicResource RaisedPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Journal tab strip -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="JOURNALS"
                               Style="{DynamicResource SectionLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <ListBox x:Name="JournalTabs"
                             SelectionChanged="JournalTabs_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{DynamicResource JournalTabItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TabTitle}"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="{DynamicResource UiFontSize}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Workspace -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="180"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: search + entry list + write button -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ENTRIES"
                                   Style="{DynamicResource SectionLabel}"
                                   Margin="2,0,0,6"/>

                        <!-- Search -->
                        <Border DockPanel.Dock="Top"
                                Style="{DynamicResource SearchBoxBorder}"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox"
                                         Style="{DynamicResource RetroTextBox}"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Grid.Column="0"
                                           Text="Search entries..."
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="{DynamicResource UiFontSize}"
                                           Margin="8,4,0,0"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="26"
                                        Height="26"
                                        Margin="0,1,1,1"
                                        Padding="0"
                                        FontSize="11"
                                        Style="{DynamicResource RetroButton}"
                                        MinWidth="26"
                                        MinHeight="26"
                                        ToolTip="Clear search"
                                        Click="ClearSearch_Click"/>
                            </Grid>
                        </Border>

                        <!-- Write Journal button -->
                        <Button DockPanel.Dock="Bottom"
                                Content="Write Journal"
                                Style="{DynamicResource PrimaryRetroButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Click="NewEntry_Click"/>

                        <!-- Entry list -->
                        <Border Style="{DynamicResource SunkenPanel}">
                            <ListBox x:Name="EntryList"
                                     Style="{DynamicResource RetroListBox}"
                                     ItemContainerStyle="{DynamicResource RetroListBoxItem}"
                                     SelectionChanged="EntryList_SelectionChanged"
                                     MouseDoubleClick="EntryList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            <TextBlock Text="{Binding Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.75"
                                                       FontSize="11"
                                                       MaxHeight="16"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <GridSplitter Grid.Column="1"
                                  Width="8"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True"/>

                    <!-- Right: reading pane -->
                    <DockPanel Grid.Column="2">
                        <!-- Entry header -->
                        <Border DockPanel.Dock="Top"
                                Style="{DynamicResource HeaderPanel}"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EntryTitleText"
                                               Style="{DynamicResource EntryTitleText}"
                                               Text="No entry selected"/>
                                    <TextBlock x:Name="EntryMetaText"
                                               Style="{DynamicResource EntryMetaText}"
                                               Margin="0,4,0,0"
                                               Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top">
                                    <Button Content="Edit"
                                            Style="{DynamicResource RetroButton}"
                                            MinWidth="60"
                                            Margin="0,0,6,0"
                                            Click="EditEntry_Click"/>
                                    <Button Content="Delete"
                                            Style="{DynamicResource RetroButton}"
                                            MinWidth="60"
                                            Click="DeleteEntry_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Body / parchment + attachments -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{DynamicResource ParchmentPanel}">
                                <Grid>
                                    <ScrollViewer x:Name="EntryScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0">
                                        <StackPanel>
                                            <TextBox x:Name="EntryBodyBox"
                                                     Style="{DynamicResource JournalBodyTextBox}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Cursor="IBeam"
                                                     Text="Select an entry from the list, or click Write Journal to begin."/>

                                            <!-- Image previews for this entry -->
                                            <WrapPanel x:Name="ImagePreviewPanel"
                                                       Margin="16,0,16,16"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <TextBlock x:Name="EmptyHint"
                                               Text="◆  No entries yet.&#x0a;&#x0a;Click Write Journal to record your first thought."
                                               FontFamily="{DynamicResource JournalFont}"
                                               FontSize="{DynamicResource JournalFontSize}"
                                               Foreground="{DynamicResource PlaceholderBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <!-- Attachment strip -->
                            <Border x:Name="AttachmentStrip"
                                    Grid.Row="1"
                                    Style="{DynamicResource SunkenPanel}"
                                    Margin="0,8,0,0"
                                    Padding="6"
                                    Visibility="Collapsed"
                                    MinHeight="72">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="ATTACHMENTS  (double-click to open)"
                                               Style="{DynamicResource SectionLabel}"
                                               Margin="2,0,0,4"/>
                                    <ListBox x:Name="EntryAttachmentList"
                                             Style="{DynamicResource RetroListBox}"
                                             ItemContainerStyle="{DynamicResource RetroListBoxItem}"
                                             MaxHeight="100"
                                             MouseDoubleClick="EntryAttachmentList_MouseDoubleClick">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open" Click="OpenSelectedAttachment_Click" Style="{StaticResource SubMenuItem}"/>
                                                <MenuItem Header="Show in Folder" Click="RevealSelectedAttachment_Click" Style="{StaticResource SubMenuItem}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Width="22" FontSize="14" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📄"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                                        <Setter Property="Text" Value="🖼"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
