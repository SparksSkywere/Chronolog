<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default brushes (overwritten at runtime by ThemeService) -->
    <SolidColorBrush x:Key="FaceBrush" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ParchmentBrush" Color="#FFF8E7"/>
    <SolidColorBrush x:Key="InkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#0A246A"/>
    <SolidColorBrush x:Key="HighlightTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#808080"/>
    <SolidColorBrush x:Key="DarkShadowBrush" Color="#404040"/>
    <SolidColorBrush x:Key="LightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F5E6C8"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#A89878"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#808080"/>
    <SolidColorBrush x:Key="MenuBarBrush" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="MenuBarTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0A246A"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#B4B0A8"/>
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#D4C4A8"/>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#404040"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#D4D0C8"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#808080"/>
    <SolidColorBrush x:Key="MetaTextBrush" Color="#555555"/>

    <FontFamily x:Key="UiFont">Tahoma, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="JournalFont">Georgia, Times New Roman, serif</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New, monospace</FontFamily>

    <CornerRadius x:Key="CornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
    <!-- Doubles are seeded in ThemeService (avoids mscorlib/System.Runtime XAML TFM issues) -->

    <!-- ═══════════════ BUTTON ═══════════════ -->
    <Style x:Key="RetroButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource FaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LightBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="InnerDark"
                                BorderBrush="{DynamicResource DarkShadowBrush}"
                                BorderThickness="0,0,1,1"
                                CornerRadius="{DynamicResource ButtonCornerRadius}">
                            <Border x:Name="InnerLight"
                                    BorderBrush="{DynamicResource LightBrush}"
                                    BorderThickness="1,1,0,0"
                                    CornerRadius="{DynamicResource ButtonCornerRadius}">
                                <Border x:Name="InnerShadow"
                                        BorderBrush="{DynamicResource ShadowBrush}"
                                        BorderThickness="0,0,1,1"
                                        CornerRadius="{DynamicResource ButtonCornerRadius}">
                                    <ContentPresenter x:Name="Content"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource ShadowBrush}"/>
                            <Setter TargetName="InnerDark" Property="BorderBrush" Value="{DynamicResource LightBrush}"/>
                            <Setter TargetName="InnerLight" Property="BorderBrush" Value="{DynamicResource DarkShadowBrush}"/>
                            <Setter TargetName="InnerShadow" Property="BorderBrush" Value="{DynamicResource LightBrush}"/>
                            <Setter TargetName="Content" Property="Margin" Value="13,5,11,3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.95"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryRetroButton" TargetType="Button" BasedOn="{StaticResource RetroButton}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <!-- ═══════════════ TEXT BOX ═══════════════ -->
    <Style x:Key="RetroTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource HighlightBrush}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource HighlightTextBrush}"/>
    </Style>

    <Style x:Key="JournalBodyTextBox" TargetType="TextBox" BasedOn="{StaticResource RetroTextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource JournalFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource JournalFontSize}"/>
        <Setter Property="Background" Value="{DynamicResource ParchmentBrush}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ═══════════════ LIST BOX ═══════════════ -->
    <Style x:Key="RetroListBox" TargetType="ListBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RetroListBoxItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ MENU (fixed visibility) ═══════════════ -->
    <Style x:Key="RetroMenu" TargetType="Menu">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Background" Value="{DynamicResource MenuBarBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuBarTextBrush}"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ShadowBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top-level menu items -->
    <Style x:Key="TopLevelMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuBarTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="-1"
                                   VerticalOffset="0">
                                <Border Background="{DynamicResource FaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrushKey}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ButtonCornerRadius}"
                                        Padding="2"
                                        MinWidth="180">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                Grid.IsSharedSizeScope="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Submenu items -->
    <Style x:Key="SubMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            MinWidth="160"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CheckMark"
                                       Grid.Column="0"
                                       Text="✓"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="HeaderHost"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="Gesture"
                                       Grid.Column="2"
                                       Margin="24,0,4,0"
                                       Text="{TemplateBinding InputGestureText}"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Opacity="0.7"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HighlightTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default MenuItem falls back to submenu style for nested items -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource SubMenuItem}"/>

    <!-- Separator inside menus -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource ShadowBrush}"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Background="{DynamicResource ShadowBrush}"
                            Margin="{TemplateBinding Margin}"
                            Opacity="0.7"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ LABELS ═══════════════ -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MetaTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="EntryTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource JournalFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="EntryMetaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MetaTextBrush}"/>
    </Style>

    <Style x:Key="StatusBarText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0"/>
    </Style>

    <Style x:Key="UiText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>

    <!-- ═══════════════ PANELS ═══════════════ -->
    <Style x:Key="StatusPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource StatusBarBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShadowBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinHeight" Value="22"/>
    </Style>

    <Style x:Key="SearchBoxBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SunkenPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShadowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="RaisedPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="HeaderPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius}"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style x:Key="ParchmentPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ParchmentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius}"/>
    </Style>

    <!-- Journal tab item style -->
    <Style x:Key="JournalTabItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabBd"
                            Background="{DynamicResource TabInactiveBrush}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Padding="12,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource FaceBrush}"/>
                            <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource FaceBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
