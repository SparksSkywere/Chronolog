<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Chronolog Classic — Windows 7 SP1 / 8 / 8.1 -->
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- Do NOT set UseWindowsForms (pollutes usings). Reference Forms only for FolderBrowserDialog. -->
    <RootNamespace>Chronolog</RootNamespace>
    <AssemblyName>Chronolog</AssemblyName>

    <ApplicationTitle>Chronolog Classic</ApplicationTitle>
    <Product>Chronolog Classic</Product>
    <AssemblyTitle>Chronolog Classic</AssemblyTitle>
    <Description>Personal journal by Skywere Industries (Windows 7/8/8.1)</Description>
    <Company>Skywere Industries</Company>
    <Authors>Skywere Industries</Authors>
    <Copyright>© Skywere Industries</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <DefineConstants>$(DefineConstants);CHRONOLOG_CLASSIC;NETFRAMEWORK</DefineConstants>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Assets\chronolog.ico</ApplicationIcon>
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\chronolog.ico" />
    <Resource Include="Assets\chronolog.png" />
    <Resource Include="Assets\chronolog-large.png" />
  </ItemGroup>

  <!-- Before every build, pull the production icon from repo assets\installer.ico -->
  <Target Name="SyncProductionIcon" BeforeTargets="PrepareForBuild;BeforeBuild;BeforePublish;ResolveWin32Resources">
    <PropertyGroup>
      <_InstallerIco>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\assets\installer.ico'))</_InstallerIco>
      <_AppIco>$(MSBuildProjectDirectory)\Assets\chronolog.ico</_AppIco>
    </PropertyGroup>
    <Copy SourceFiles="$(_InstallerIco)" DestinationFiles="$(_AppIco)" SkipUnchangedFiles="false"
          Condition="Exists('$(_InstallerIco)')" />
    <Message Importance="high" Text="Synced app icon from assets\installer.ico" Condition="Exists('$(_InstallerIco)')" />
  </Target>

</Project>
