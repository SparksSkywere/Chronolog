<Window x:Class="Chronolog.Views.WriteEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Journal"
        Height="620"
        Width="700"
        MinHeight="480"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FaceBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Title:"
                       VerticalAlignment="Center"
                       Style="{DynamicResource UiText}"/>
            <Border Grid.Column="1" Style="{DynamicResource SearchBoxBorder}">
                <TextBox x:Name="TitleBox"
                         Style="{DynamicResource RetroTextBox}"
                         MaxLength="200"/>
            </Border>
        </Grid>

        <!-- Date -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Date:"
                       VerticalAlignment="Center"
                       Style="{DynamicResource UiText}"/>
            <DatePicker x:Name="DatePicker"
                        Grid.Column="1"
                        Width="180"
                        FontFamily="{DynamicResource UiFont}"
                        FontSize="{DynamicResource UiFontSize}"
                        SelectedDateFormat="Long"/>
            <TextBlock Grid.Column="2"
                       Text="  (drag files anywhere onto this window to attach)"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MetaTextBrush}"
                       FontSize="11"/>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Entry:"
                       Style="{DynamicResource SectionLabel}"
                       Margin="0,0,0,4"/>
            <Border Grid.Row="1" Style="{DynamicResource ParchmentPanel}">
                <TextBox x:Name="BodyBox"
                         Style="{DynamicResource JournalBodyTextBox}"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>

        <!-- Attachments header -->
        <DockPanel Grid.Row="3" Margin="0,10,0,4">
            <TextBlock DockPanel.Dock="Left"
                       Text="ATTACHMENTS"
                       Style="{DynamicResource SectionLabel}"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Attach files..."
                        Style="{DynamicResource RetroButton}"
                        MinWidth="100"
                        Margin="0,0,6,0"
                        Click="AttachFiles_Click"/>
                <Button Content="Remove"
                        Style="{DynamicResource RetroButton}"
                        MinWidth="70"
                        Click="RemoveAttachment_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Attachments list -->
        <Border Grid.Row="4" Style="{DynamicResource SunkenPanel}">
            <Grid>
                <ListBox x:Name="AttachmentList"
                         Style="{DynamicResource RetroListBox}"
                         ItemContainerStyle="{DynamicResource RetroListBoxItem}"
                         MouseDoubleClick="AttachmentList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left"
                                           Width="22"
                                           FontSize="14"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="📄"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Text" Value="🖼"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SizeLabel}"
                                               FontSize="11"
                                               Opacity="0.75"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoAttachmentsHint"
                           Text="No attachments — click Attach files… or drop files here"
                           Foreground="{DynamicResource PlaceholderBrush}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="SaveButton"
                    Content="Save Entry"
                    Style="{DynamicResource PrimaryRetroButton}"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"/>
            <Button Content="Cancel"
                    Style="{DynamicResource RetroButton}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
