<Window x:Class="Chronolog.Views.NewJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Journal"
        Height="230"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FaceBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create a new journal volume."
                   Style="{DynamicResource UiText}"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource MetaTextBrush}"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Journal name:"
                       VerticalAlignment="Center"
                       Style="{DynamicResource UiText}"/>
            <Border Grid.Column="1" Style="{DynamicResource SearchBoxBorder}">
                <TextBox x:Name="NameBox"
                         Style="{DynamicResource RetroTextBox}"
                         MaxLength="80"
                         Text="Personal Journal"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Owner name:"
                       VerticalAlignment="Center"
                       Style="{DynamicResource UiText}"/>
            <Border Grid.Column="1" Style="{DynamicResource SearchBoxBorder}">
                <TextBox x:Name="OwnerBox"
                         Style="{DynamicResource RetroTextBox}"
                         MaxLength="80"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Tabs appear as &quot;Owner's Journal&quot; when an owner is set."
                   FontSize="11"
                   Foreground="{DynamicResource MetaTextBrush}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Create"
                    Style="{DynamicResource PrimaryRetroButton}"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="CreateButton_Click"/>
            <Button Content="Cancel"
                    Style="{DynamicResource RetroButton}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
