<Window x:Class="Chronolog.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="420"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FaceBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/chronolog.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Classic product header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="64" Height="64"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="1"
                    Background="{DynamicResource WindowBrush}"
                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                    Margin="0,0,14,0"
                    SnapsToDevicePixels="True">
                <Image Source="pack://application:,,,/Assets/chronolog-large.png"
                       Stretch="Uniform"
                       Margin="4"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ProductNameText"
                           Text="Chronolog"
                           FontFamily="{DynamicResource JournalFont}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="VersionText"
                           Text="Version 1.0"
                           FontSize="12"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource MetaTextBrush}"/>
                <TextBlock x:Name="EditionOsText"
                           Text="Personal Journal Software"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource InkBrush}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Height="1"
                Background="{DynamicResource ShadowBrush}"
                Margin="0,0,0,12"
                Opacity="0.6"/>

        <!-- Company / product info (classic About box body) -->
        <Border Grid.Row="2"
                Style="{DynamicResource SunkenPanel}"
                Padding="12"
                Background="{DynamicResource WindowBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Skywere Industries"
                               FontWeight="SemiBold"
                               FontSize="14"
                               FontFamily="{DynamicResource UiFont}"
                               Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="SuiteLineText"
                               Text="Chronolog Journal Suite"
                               FontSize="12"
                               Margin="0,2,0,10"
                               Foreground="{DynamicResource MetaTextBrush}"/>

                    <TextBlock x:Name="AboutBodyText"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{DynamicResource InkBrush}"
                               Text=""/>

                    <TextBlock Margin="0,14,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MetaTextBrush}"
                               TextWrapping="Wrap"
                               Text="© Skywere Industries. All rights reserved.&#x0a;This software is provided for personal use."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Library path footer -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Library location"
                       FontSize="11"
                       Foreground="{DynamicResource MetaTextBrush}"
                       Margin="0,0,0,2"/>
            <TextBlock x:Name="LibraryPathText"
                       FontSize="11"
                       FontFamily="{DynamicResource MonoFont}"
                       Foreground="{DynamicResource InkBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="OK"
                    Style="{DynamicResource PrimaryRetroButton}"
                    IsDefault="True"
                    IsCancel="True"
                    Width="88"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
