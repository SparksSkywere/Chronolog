<Window x:Class="Chronolog.Views.StorageLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage Location"
        Height="420"
        Width="560"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FaceBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{DynamicResource UiFont}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/chronolog.ico">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Journal library location"
                   FontSize="16"
                   FontWeight="SemiBold"
                   FontFamily="{DynamicResource JournalFont}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource MetaTextBrush}"
                   LineHeight="18"
                   Margin="0,0,0,12"
                   Text="Choose a folder for journals.json and attachments. Use a OneDrive, Dropbox, network, or USB path on every computer so you can add and edit the same entries from multiple PCs."/>

        <TextBlock Grid.Row="2"
                   Text="Current location"
                   Style="{DynamicResource SectionLabel}"/>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource SearchBoxBorder}">
                <TextBox x:Name="PathBox"
                         Style="{DynamicResource RetroTextBox}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="28"
                         VerticalContentAlignment="Center"/>
            </Border>
            <Button Grid.Column="1"
                    Content="Browse..."
                    Style="{DynamicResource RetroButton}"
                    Margin="8,0,0,0"
                    MinWidth="90"
                    Click="Browse_Click"/>
            <Button Grid.Column="2"
                    Content="Default"
                    Style="{DynamicResource RetroButton}"
                    Margin="6,0,0,0"
                    MinWidth="80"
                    ToolTip="Reset to this PC's default Chronolog library folder"
                    Click="Default_Click"/>
        </Grid>

        <Border Grid.Row="4"
                Style="{DynamicResource SunkenPanel}"
                Padding="12"
                Background="{DynamicResource WindowBrush}">
            <StackPanel>
                <TextBlock Text="When you change location"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,8"/>

                <RadioButton x:Name="OptionSwitchOnly"
                             GroupName="MoveMode"
                             IsChecked="True"
                             Margin="0,0,0,8"
                             FontFamily="{DynamicResource UiFont}"
                             FontSize="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Switch only — open journals already in the new folder (or start empty there). Best when both PCs already share this folder."/>
                </RadioButton>

                <RadioButton x:Name="OptionCopy"
                             GroupName="MoveMode"
                             Margin="0,0,0,8"
                             FontFamily="{DynamicResource UiFont}"
                             FontSize="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Copy current library into the new folder, then switch. Safe first-time setup for cloud sync."/>
                </RadioButton>

                <RadioButton x:Name="OptionMove"
                             GroupName="MoveMode"
                             FontFamily="{DynamicResource UiFont}"
                             FontSize="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Move current library (copy, then leave a note; original files stay until you delete them)."/>
                </RadioButton>

                <TextBlock Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MetaTextBrush}"
                           TextWrapping="Wrap"
                           Text="Tip: On a second computer, install Chronolog, open Storage Location, browse to the same shared folder, and choose Switch only."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Apply"
                    Style="{DynamicResource PrimaryRetroButton}"
                    IsDefault="True"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="Apply_Click"/>
            <Button Content="Cancel"
                    Style="{DynamicResource RetroButton}"
                    IsCancel="True"
                    MinWidth="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
